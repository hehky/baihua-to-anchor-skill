    "anyway": "(?:^|(?<=[,.;!?] ))[Aa]nyway\\b",
    "um": "\\b[Uu]m\\b",
    "uh": "\\b[Uu]h\\b",
    "you know": "(?<=, )you know(?=,)",
    "i mean": "(?:^|(?<=[,.;!?] ))[Ii] mean\\b",
    "ok": "(?:^|(?<=[,.;!?] ))[Oo][Kk](?=$|[,.;!?])",
    "okay": "(?:^|(?<=[,.;!?] ))[Oo]kay(?=$|[,.;!?])",
    "lol": "\\blol\\b",
    "haha": "\\bhaha\\b",
    "maybe": "(?:^|(?<=[,.;!?] ))[Mm]aybe(?=\\s+(you|just|try)\\b)",
    "can you": "\\b[Cc]an you(?=\\s+(please\\s+)?(help|fix|check|look|take|write|add|make|split|deploy|change|set|run|sort|deal|handle|refactor|clean|update|remove|delete|create|build|implement|figure|tell|get|see|restart|move|convert|translate|optimize|merge|investigate|debug|rename|migrate|upgrade|speed|generate|turn)\\b)",
