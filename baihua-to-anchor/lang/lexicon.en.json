    "so": "(?:^|(?<=[,.;!?] ))[Ss]o\\b(?=,|\\s+(i|we|my|the|it|this|that|our)\\b)",
    "like": "(?<=, )like(?=,)",
    "actually": "(?:^|(?<=[,.;!?] ))[Aa]ctually\\b",
